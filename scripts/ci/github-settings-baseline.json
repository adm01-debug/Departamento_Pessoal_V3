{
  "_comment": "Baseline medido em 2026-11-09. Regenerar quando mudar uma config intencional.",
  "medido_em": "2026-11-09",
  "branch_protection_main": {
    "_comment": "DP V3 usa rulesets (não classic branch protection). checarBranchProtection() lança NaoVerificavel em 404 — comportamento esperado. Se migrar para classic BP, preencher os campos e remover este comentário.",
    "strict": true,
    "enforce_admins": true,
    "required_status_checks": [],
    "required_linear_history": true,
    "allow_force_pushes": false
  },
  "merge": {
    "allow_auto_merge": true,
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "delete_branch_on_merge": true,
    "squash_merge_commit_message": "COMMIT_MESSAGES",
    "squash_merge_commit_title": "COMMIT_OR_PR_TITLE"
  },
  "security_and_analysis": {
    "secret_scanning": "enabled",
    "secret_scanning_push_protection": "enabled"
  },
  "actions": {
    "enabled": true,
    "allowed_actions": "selected",
    "sha_pinning_required": true
  },
  "workflow_permissions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": true
  },
  "selected_actions_patterns": [
    "denoland/*",
    "supabase/*",
    "ossf/*",
    "dorny/*",
    "zizmorcore/*",
    "gitleaks/*"
  ],
  "selected_actions_verified_allowed": true,
  "selected_actions_github_owned_allowed": true,
  "rulesets_count": 1,
  "environments": [
    "copilot",
    "Preview",
    "Production"
  ],
  "environments_vercel_managed": {
    "prefixos": ["Preview ", "Production "]
  }
}
