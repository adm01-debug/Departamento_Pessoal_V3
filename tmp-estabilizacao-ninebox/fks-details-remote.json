[{"result":"{\n    \"audit_fks\": [\n    ],\n    \"ciclos_columns\": [\n        {\n            \"type\": \"uuid\",\n            \"column\": \"id\",\n            \"nullable\": \"NO\"\n        },\n        {\n            \"type\": \"uuid\",\n            \"column\": \"empresa_id\",\n            \"nullable\": \"YES\"\n        },\n        {\n            \"type\": \"text\",\n            \"column\": \"nome\",\n            \"nullable\": \"NO\"\n        },\n        {\n            \"type\": \"text\",\n            \"column\": \"descricao\",\n            \"nullable\": \"YES\"\n        },\n        {\n            \"type\": \"date\",\n            \"column\": \"data_inicio\",\n            \"nullable\": \"NO\"\n        },\n        {\n            \"type\": \"date\",\n            \"column\": \"data_fim\",\n            \"nullable\": \"NO\"\n        },\n        {\n            \"type\": \"text\",\n            \"column\": \"status\",\n            \"nullable\": \"NO\"\n        },\n        {\n            \"type\": \"text\",\n            \"column\": \"tipo\",\n            \"nullable\": \"YES\"\n        },\n        {\n            \"type\": \"timestamp with time zone\",\n            \"column\": \"created_at\",\n            \"nullable\": \"NO\"\n        },\n        {\n            \"type\": \"timestamp with time zone\",\n            \"column\": \"updated_at\",\n            \"nullable\": \"NO\"\n        }\n    ],\n    \"pdi_cycle_columns\": [\n    ],\n    \"cycle_trigger_defs\": [\n        {\n            \"name\": \"audit_status_change\",\n            \"function\": \"trg_audit_status_change\",\n            \"definition\": \"CREATE OR REPLACE FUNCTION public.trg_audit_status_change()\\n RETURNS trigger\\n LANGUAGE plpgsql\\n SECURITY DEFINER\\n SET search_path TO 'public'\\nAS $function$\\nDECLARE\\n  _uid uuid;\\n  _empresa uuid;\\nBEGIN\\n  IF OLD.status IS NOT DISTINCT FROM NEW.status THEN\\n    RETURN NEW;\\n  END IF;\\n\\n  BEGIN _uid := auth.uid(); EXCEPTION WHEN OTHERS THEN _uid := NULL; END;\\n\\n  -- Best-effort empresa_id (nem toda tabela tem)\\n  BEGIN\\n    EXECUTE format('SELECT ($1).empresa_id') INTO _empresa USING NEW;\\n  EXCEPTION WHEN OTHERS THEN\\n    _empresa := NULL;\\n  END;\\n\\n  INSERT INTO public.audit_log (\\n    tabela, registro_id, acao, user_id,\\n    dados_anteriores, dados_novos\\n  ) VALUES (\\n    TG_TABLE_NAME,\\n    NEW.id,\\n    'STATUS_CHANGE',\\n    _uid,\\n    jsonb_build_object('status', OLD.status, 'empresa_id', _empresa),\\n    jsonb_build_object('status', NEW.status, 'empresa_id', _empresa,\\n                       'changed_at', now())\\n  );\\n\\n  RETURN NEW;\\nEXCEPTION WHEN OTHERS THEN\\n  -- Auditoria nunca deve derrubar o UPDATE do domínio\\n  RETURN NEW;\\nEND;\\n$function$\\n\"\n        },\n        {\n            \"name\": \"ciclos_status_transition\",\n            \"function\": \"trg_ciclos_status_transition\",\n            \"definition\": \"CREATE OR REPLACE FUNCTION public.trg_ciclos_status_transition()\\n RETURNS trigger\\n LANGUAGE plpgsql\\n SET search_path TO 'public'\\nAS $function$\\nBEGIN\\n  IF public._is_admin_bypass() THEN RETURN NEW; END IF;\\n  PERFORM public.validate_status_transition('ciclos_avaliacao', OLD.status, NEW.status, '{\\n    \\\"rascunho\\\": [\\\"ativo\\\",\\\"cancelado\\\"],\\n    \\\"ativo\\\": [\\\"em_andamento\\\",\\\"cancelado\\\",\\\"arquivado\\\"],\\n    \\\"em_andamento\\\": [\\\"concluido\\\",\\\"cancelado\\\"],\\n    \\\"concluido\\\": [\\\"arquivado\\\"]\\n  }'::jsonb);\\n  RETURN NEW;\\nEND; $function$\\n\"\n        },\n        {\n            \"name\": \"update_ciclos_avaliacao_updated_at\",\n            \"function\": \"update_updated_at_column\",\n            \"definition\": \"CREATE OR REPLACE FUNCTION public.update_updated_at_column()\\n RETURNS trigger\\n LANGUAGE plpgsql\\n SET search_path TO 'public'\\nAS $function$\\nBEGIN\\n    NEW.updated_at = NOW();\\n    RETURN NEW;\\nEND;\\n$function$\\n\"\n        }\n    ]\n}"}]
