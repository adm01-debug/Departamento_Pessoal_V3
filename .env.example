# Environment Variables
# Copy to .env.local and fill in your values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Somente no desenvolvimento local: passa Edge Functions pelo proxy do Vite,
# que aplica a origem permitida pelo projeto. Em produção, deixe ausente.
VITE_SUPABASE_FUNCTIONS_BASE=/functions/v1
VITE_API_URL=/api

# ─── Sentry (P3-053) ────────────────────────────────────────
# DSN: https://sentry.io/settings/<org>/projects/<proj>/keys/
VITE_SENTRY_DSN=https://xxxx@sentry.io/xxxx
# Release: preencher via CI (sentryVitePlugin setCommits: { auto: true })
VITE_SENTRY_RELEASE=
VITE_SENTRY_ORG=dp-team
VITE_SENTRY_PROJECT=departamento-pessoal-v2
# AuthToken: só em CI (não commitado) — gerado em sentry.io/settings/tokens
# SENTRY_AUTH_TOKEN=
