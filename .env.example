# Environment Variables
# Copy to .env.local and fill in your values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_API_URL=/api

# ─── Sentry (P3-053) ────────────────────────────────────────
# DSN: https://sentry.io/settings/<org>/projects/<proj>/keys/
VITE_SENTRY_DSN=https://xxxx@sentry.io/xxxx
# Release: preencher via CI (sentryVitePlugin setCommits: { auto: true })
VITE_SENTRY_RELEASE=
VITE_SENTRY_ORG=dp-team
VITE_SENTRY_PROJECT=departamento-pessoal-v2
# AuthToken: só em CI (não commitado) — gerado em sentry.io/settings/tokens
# SENTRY_AUTH_TOKEN=
# ─── Mock visual de layout (somente DEV) ────────────────────
# Preenche as telas de Tempo & Ausências (Ponto, Horas Extras, Banco de Horas,
# Turnos & Escalas, Férias, Afastamentos, Feriados, Controle de Acesso) com
# dados fictícios para avaliação visual. Nada é gravado no Supabase.
# Ignorado em produção e em testes. Ver src/mocks/layoutMock/index.ts.
VITE_LAYOUT_MOCK=false

# ─── Gestão de Desempenho (mock) ────────────────────────────
# Mantém o modo demonstração do módulo. Deixe `false` para usar dados reais.
VITE_DESEMPENHO_MOCK=false

# ─── Nine-Box: modo REAL (somente DEV/local) ────────────────
# Liga as RPCs de gravação (criar_feedback_seguro/finalizar_feedback/
# validar_potencial_avaliacao) e a matriz a partir das avaliações persistidas.
# Em produção o padrão é `false` (variável ausente). Ver nineBoxModo.ts.
# VITE_NINEBOX_MODO_REAL=true
